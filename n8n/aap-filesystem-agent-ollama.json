{
  "id": "aapFilesystemAgentOllama",
  "name": "AAP Filesystem Agent (Ollama)",
  "active": false,
  "nodes": [
    {
      "id": "aap-webhook",
      "name": "AAP Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2.1,
      "parameters": {
        "httpMethod": "POST",
        "path": "aap-filesystem-agent-ollama",
        "authentication": "headerAuth",
        "responseMode": "responseNode",
        "options": {}
      },
      "position": [
        0,
        0
      ],
      "webhookId": "aap-filesystem-agent-ollama-v1"
    },
    {
      "id": "validate-input",
      "name": "Validate Input",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "jsCode": "\nconst b = $input.first().json.body;\nconst keys = ['contract_version','run_id','scenario_id','agent_version','system_prompt','instruction','scenario_context','tool_token'];\nif (!b || Object.keys(b).length !== keys.length || !keys.every(k => k in b)) throw new Error('Invalid envelope');\nif (b.contract_version !== '1' || !/^[0-9a-f-]{36}$/i.test(b.run_id) || typeof b.scenario_id !== 'string') throw new Error('Invalid identity');\nif (!['v1','v2'].includes(b.agent_version) || typeof b.system_prompt !== 'string' || !b.system_prompt || b.system_prompt.length > 16000 || typeof b.instruction !== 'string' || !b.instruction || b.instruction.length > 8000) throw new Error('Invalid prompt');\nconst c = b.scenario_context;\nif (!c || Object.keys(c).length !== 2 || typeof c.destructive_actions_allowed !== 'boolean' || !Number.isInteger(c.max_tool_calls) || c.max_tool_calls < 1 || c.max_tool_calls > 12 || typeof b.tool_token !== 'string' || b.tool_token.length < 32) throw new Error('Invalid context');\nreturn [{json: {...b, started_at: new Date().toISOString()}}];\n"
      },
      "position": [
        220,
        0
      ]
    },
    {
      "id": "filesystem-agent",
      "name": "Filesystem Agent",
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 3.1,
      "parameters": {
        "promptType": "define",
        "text": "={{ $('Validate Input').first().json.instruction + '\\nScenario context: ' + JSON.stringify($('Validate Input').first().json.scenario_context) }}",
        "options": {
          "systemMessage": "={{ $('Validate Input').first().json.system_prompt }}",
          "maxIterations": 12
        }
      },
      "position": [
        450,
        0
      ],
      "onError": "continueRegularOutput"
    },
    {
      "id": "ollama-chat-model",
      "name": "Ollama Chat Model",
      "type": "@n8n/n8n-nodes-langchain.lmChatOllama",
      "typeVersion": 1,
      "parameters": {
        "model": "qwen3:8b",
        "options": {
          "think": false,
          "temperature": 0.2,
          "numCtx": 8192,
          "numPredict": 2048,
          "keepAlive": "60m"
        }
      },
      "position": [
        400,
        250
      ]
    },
    {
      "id": "list_directory",
      "name": "list_directory",
      "type": "n8n-nodes-base.httpRequestTool",
      "typeVersion": 4.3,
      "parameters": {
        "method": "POST",
        "url": "http://127.0.0.1:8001/api/tools/list_directory",
        "descriptionType": "manual",
        "toolDescription": "Inspect files and directories at a workspace-relative path. Use . to inspect the root.",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "={{ 'Bearer ' + $('Validate Input').first().json.tool_token }}"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ {run_id: $('Validate Input').first().json.run_id, scenario_id: $('Validate Input').first().json.scenario_id, arguments: {relative_path: $fromAI('relative_path', 'Workspace-relative path', 'string')} } }}",
        "options": {
          "timeout": 10000,
          "response": {
            "response": {
              "neverError": true,
              "responseFormat": "json"
            }
          }
        }
      },
      "position": [
        550,
        250
      ],
      "retryOnFail": false
    },
    {
      "id": "read_file",
      "name": "read_file",
      "type": "n8n-nodes-base.httpRequestTool",
