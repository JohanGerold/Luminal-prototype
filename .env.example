# Set these in your local shell; keys are not read from this file automatically.
# Model credentials live only in n8n, never here or in browser configuration.
# LIVE_MODEL provider:
#   groq          cloud openai/gpt-oss-120b, AAP runs the agent loop (no n8n, no local GPU load)
#   ollama        local qwen3:8b through the n8n workflow (heavy GPU use)
#   direct-ollama local qwen3:8b, AAP runs the agent loop (heavy GPU use)
#   gemini        Google Gemini through the n8n workflow (credential stays in n8n)
AAP_LIVE_PROVIDER=groq
# Groq API key from https://console.groq.com/keys - only in your local .env, never committed.
# AAP_GROQ_API_KEY=
# Shared secret for the n8n webhook header-auth credential; generate a long random value locally.
# AAP_N8N_AUTH_TOKEN=
AAP_DEMO_ROOT=C:\AAP-Demo-Workspace
# AAP_DJANGO_SECRET_KEY=generate-a-local-random-value
